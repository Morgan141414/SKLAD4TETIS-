# IoT sensor bridge configuration
# Copy to /opt/sklad/iot/.env.iot and fill in your values

# Serial port where CH340 sensor is connected
CH340_PORT=/dev/ttyUSB0

# Baud rate — get from Arduino sketch (common: 9600 or 115200)
CH340_BAUD=9600

# Sensor device ID from the sklad UI (Условия хранения → add device, note its ID)
CH340_DEVICE_ID=1

# API endpoint (default: local service)
CH340_API_URL=http://localhost:8120/api/v1

# Bearer token (leave empty if SKLAD_PUBLIC_ACCESS_ENABLED=true in .env)
CH340_API_TOKEN=

# Minimum seconds between readings posted to API (avoid flooding)
CH340_INTERVAL=30

# Set to 1 to log every raw serial line (helps diagnose unknown format)
CH340_VERBOSE=0

# Override field names if sensor sends JSON with non-standard keys
# CH340_TEMP_FIELD=temp_c
# CH340_HUM_FIELD=rh_percent
