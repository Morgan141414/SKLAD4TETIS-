# Runtime mode. SQLite is allowed only in demo.
SKLAD_DEPLOYMENT_MODE=demo

# Demo/local mode.
SKLAD_DATABASE_BACKEND=sqlite
SKLAD_DATABASE_URL=sqlite:///./sklad.db

# Staging/production must use PostgreSQL.
# SKLAD_DATABASE_BACKEND=postgresql
# SKLAD_DATABASE_URL=postgresql+psycopg://sklad:change-me@postgres:5432/sklad

# Header-based auth is for local/demo only. Keep false outside trusted dev runs.
SKLAD_DEV_AUTH_ENABLED=false

# JWT settings for non-demo auth.
SKLAD_JWT_HMAC_SECRET=
SKLAD_JWT_ALGORITHM=HS256
SKLAD_JWT_ISSUER=
SKLAD_JWT_AUDIENCE=
SKLAD_JWT_CLOCK_SKEW_SECONDS=30

# Background maintenance jobs.
SKLAD_BACKGROUND_JOBS_ENABLED=false
SKLAD_BACKGROUND_JOBS_INTERVAL_SECONDS=3600
SKLAD_BACKGROUND_JOBS_EXPIRY_DAYS=30
SKLAD_BACKGROUND_JOBS_ACTOR_ID=system-scheduler
